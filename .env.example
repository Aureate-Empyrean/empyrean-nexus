# Loopback is deliberate. Set an HTTPS origin and use a TLS reverse proxy for remote access.
NEXUS_BIND=127.0.0.1
NEXUS_PORT=12333
NEXUS_PUBLIC_ORIGIN=http://localhost:12333
NEXUS_INSTALLATION=nexus
# Development only: set to 1 to accept the exact locally built reference image tag and offer
# its manifest in the install dialog. All other images require a digest.
NEXUS_ALLOW_EXAMPLE=0

# Additional exact browser origins, comma-separated, using the same HTTP/HTTPS scheme.
# Localhost automatically permits its IPv4/IPv6 loopback aliases.
NEXUS_ALLOWED_ORIGINS=
# LAN example: NEXUS_BIND=0.0.0.0 and add http://192.168.100.32:12333 above.
