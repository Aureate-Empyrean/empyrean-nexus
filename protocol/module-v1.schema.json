{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "protocol": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 48,
      "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
      "not": {
        "const": "nexus"
      }
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40,
      "pattern": "^(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)(?:-(?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*))*)?$",
      "description": "Semantic Versioning 2.0.0 without build metadata; prerelease identifiers are compared by SemVer precedence."
    },
    "publisher": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "originalAuthors": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "uniqueItems": true,
          "maxItems": 10
        }
      },
      "required": [
        "name",
        "originalAuthors"
      ]
    },
    "repository": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "format": "uri",
      "pattern": "^https://"
    },
    "license": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "homepage": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "format": "uri",
      "pattern": "^https://"
    },
    "nexus": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "container": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "image": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "port": {
          "type": "integer",
          "enum": [
            13333,
            14333,
            15333,
            16333,
            17333,
            18333,
            19333,
            20333,
            21333,
            22333,
            23333,
            24333,
            25333,
            26333,
            27333,
            28333,
            29333,
            30333,
            31333,
            32333,
            33333,
            34333,
            35333,
            36333,
            37333,
            38333,
            39333,
            40333,
            41333,
            42333,
            43333,
            44333,
            45333,
            46333,
            47333,
            48333,
            49333,
            50333,
            51333,
            52333,
            53333,
            54333,
            55333,
            56333,
            57333,
            58333,
            59333,
            60333,
            61333,
            62333,
            63333,
            64333,
            65333
          ]
        }
      },
      "required": [
        "image",
        "port"
      ]
    },
    "capabilities": {
      "type": "array",
      "items": {
        "enum": [
          "events.publish",
          "events.subscribe",
          "notifications.publish",
          "references.create",
          "references.read",
          "references.resolve",
          "storage.data",
          "blobs.read",
          "blobs.write",
          "ui.application",
          "network.egress",
          "projections.read"
        ]
      },
      "uniqueItems": true,
      "maxItems": 16
    },
    "routes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ui": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^/[a-zA-Z0-9/_-]*$"
        },
        "api": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^/[a-zA-Z0-9/_-]*$"
        },
        "health": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^/[a-zA-Z0-9/_-]*$"
        }
      },
      "required": [
        "ui",
        "api",
        "health"
      ]
    },
    "icon": {
      "type": "string",
      "minLength": 6,
      "maxLength": 100,
      "pattern": "^/[a-zA-Z0-9_-]+(/[a-zA-Z0-9_-]+)*\\.(svg|png|webp)$",
      "description": "Application icon (Nexus >=0.1.8): a path the module serves itself, fetched by Nexus through the owner-authenticated module gateway and shown as an image in the application switcher and module list. A square tile, full-bleed; Nexus applies the corner radius. SVG, PNG or WebP."
    },
    "events": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "produces": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9_-]*)+$"
          },
          "uniqueItems": true,
          "maxItems": 32
        },
        "consumes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9_-]*)+$"
          },
          "uniqueItems": true,
          "maxItems": 32
        }
      },
      "required": [
        "produces",
        "consumes"
      ]
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "url": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "format": "uri",
          "pattern": "^https://"
        }
      },
      "required": [
        "url"
      ]
    },
    "references": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "read",
        "resolve"
      ],
      "properties": {
        "version": {
          "enum": [
            1,
            2
          ],
          "description": "1: opaque resource IDs. 2: canonical lowercase UUID resource IDs and optional outgoing-reference enumeration (Nexus >=0.1.3)."
        },
        "read": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "module",
              "type"
            ],
            "properties": {
              "module": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
                "maxLength": 48
              },
              "type": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
                "maxLength": 48
              }
            }
          }
        },
        "resolve": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "module",
              "type"
            ],
            "properties": {
              "module": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
                "maxLength": 48
              },
              "type": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
                "maxLength": 48
              }
            }
          }
        },
        "enumerate": {
          "type": "boolean",
          "description": "The module serves GET /empyrean/v1/references/outgoing so Nexus can rebuild its derived index. Requires version 2 and references.create."
        }
      }
    },
    "resources": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "resolvable"
        ],
        "properties": {
          "type": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
            "maxLength": 48
          },
          "resolvable": {
            "type": "boolean"
          }
        }
      }
    },
    "backup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "objects": {
          "type": "boolean",
          "description": "The module's full backups list content-addressed objects that Nexus stores once and shares between backups (Nexus >=0.1.14)."
        }
      },
      "description": "The module implements the backup/restore contract (Nexus >=0.1.3). Requires storage.data."
    },
    "projections": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "provides",
        "read"
      ],
      "description": "Projection queries (Nexus >=0.1.5): projection contracts this module serves at POST /empyrean/v1/projections/<name>, and exact module/projection scopes it may query.",
      "properties": {
        "version": {
          "const": 1
        },
        "provides": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
            "maxLength": 48
          }
        },
        "read": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "module",
              "projection"
            ],
            "properties": {
              "module": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
                "maxLength": 48
              },
              "projection": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
                "maxLength": 48
              }
            }
          }
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "memory_mb"
      ],
      "properties": {
        "memory_mb": {
          "type": "integer",
          "minimum": 256,
          "maximum": 1024,
          "description": "Memory the container needs, reviewed by the owner (Nexus >=0.1.14). The default is 256."
        }
      }
    }
  },
  "required": [
    "protocol",
    "id",
    "name",
    "description",
    "version",
    "publisher",
    "repository",
    "license",
    "nexus",
    "container",
    "capabilities",
    "routes",
    "events"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aureate-empyrean.org/protocol/module-v1.schema.json",
  "title": "Empyrean Module Protocol v1"
}
